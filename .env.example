# Twilio Credentials (get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

# Google (Calendar + Sheets share ONE service account: gcal-credentials.json)
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
DOCTOR_EMAIL=doctor@example.com
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_MEET_LINK=

# Google Sheets lead logging (optional). Enable the Sheets API, create a sheet,
# share it with the service account email (Editor), then paste the sheet ID
# from its URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
LEAD_SOURCE=WhatsApp bot
LEAD_DEFAULT_STATUS=New
